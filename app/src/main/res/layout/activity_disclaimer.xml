<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="10dp"
    android:weightSum="1"
    tools:context=".activities.DisclaimerActivity">
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.17"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.56"
        android:background="@color/colorWhite"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:weightSum="1">
        <ImageView
            android:id="@+id/img_exclamation_mark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3"
            android:gravity="center_horizontal"
            android:paddingHorizontal="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/exclamation_mark" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.08"
            android:gravity="center_horizontal"
            android:singleLine="false"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:text="@string/text_warning"
            android:textColor="@color/colorPrimaryDark"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeStepGranularity="2sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2"
            android:gravity="center_horizontal"
            android:singleLine="false"
            android:textAllCaps="false"
            android:text="@string/text_disclaimer_warning"
            android:textColor="@color/colorBlack"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="19sp"
            app:autoSizeStepGranularity="2sp"/>
        <TextView
            android:id="@+id/txt_view_terms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12"
            android:gravity="center"
            android:singleLine="false"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:text="@string/text_disclaimer_view_terms"
            android:textColor="@color/colorPrimaryDark"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="17sp"
            app:autoSizeStepGranularity="2sp"/>
        <ImageView
            android:id="@+id/img_weighsafe_logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.3"
            android:gravity="center_horizontal"
            android:padding="17dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ws_logo" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15"/>


    <Button
        android:id="@+id/btn_accept_Terms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:layout_gravity="center"
        android:drawableLeft="@drawable/ic_outline_check_box_24"
        android:drawablePadding="20dp"
        android:gravity="center"
        android:singleLine="true"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:text="@string/text_accept_terms"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeStepGranularity="2sp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        android:backgroundTint="@color/colorPrimary"/>
</LinearLayout>