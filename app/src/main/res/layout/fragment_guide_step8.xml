<?xml version="1.0" encoding="utf-8"?>
<com.otaliastudios.zoom.ZoomLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.GuideStep8Fragment"
    android:background="@color/colorWhite"
    android:paddingTop="@dimen/main_dimen_40"
    android:paddingLeft="@dimen/main_dimen_40"
    android:paddingRight="@dimen/main_dimen_40"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:transformation="none"
    app:transformationGravity="auto"
    app:alignment="top"
    app:overScrollHorizontal="false"
    app:overScrollVertical="false"
    app:overPinchable="false"
    app:horizontalPanEnabled="true"
    app:verticalPanEnabled="true"
    app:zoomEnabled="true"
    app:scrollEnabled="true"
    app:oneFingerScrollEnabled="true"
    app:twoFingersScrollEnabled="true"
    app:minZoom="1"
    app:minZoomType="zoom"
    app:maxZoom="5"
    app:maxZoomType="zoom"
    app:animationDuration="280"
    app:hasClickableChildren="true">

    <!--<com.weigh.safe.helpers.ZoomableRelativeLayout-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="wrap_content">-->
        <LinearLayout
            android:id="@+id/step_linearlayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:text="@string/live_weight"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:text="@string/live_weight_text_1"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:textAlignment="center"
                android:text="@string/required_tongue_weight"/>
            <TextView
                android:id="@+id/guide_result"
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textColor="@color/colorPrimaryDark"
                android:textAlignment="center"
                android:text="---"/>
            <LinearLayout
                android:id="@+id/ll_calculate_box"
                android:visibility="gone"
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="11">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_min_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/min_lbs"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/colorGrey" />
                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_left_arrow_back_24_black"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/val_safe_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/target_lbs"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/colorGrey" />
                </LinearLayout>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_right_arrow_forward_24_black"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_max_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/max_lbs"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/colorGrey" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:text="@string/live_weight_text_note"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:text="@string/live_weight_text_2"/>
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:src="@drawable/step8"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:text="@string/live_weight_text_3"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:textStyle="italic"
                android:text="@string/live_weight_notice"/>
            <TextView
                android:id="@+id/close_guide"
                android:visibility="gone"
                android:layout_margin="@dimen/main_dimen_40"
                android:textAlignment="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryDark"
                android:text="@string/close_guide"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/main_dimen_40">
                <ImageView
                    android:id="@+id/img_back_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back_24"/>

                <TextView
                    android:id="@+id/go_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/img_back_page"
                    android:layout_marginLeft="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/colorGrey"
                    android:textSize="16dp"
                    android:text="@string/text_back" />

                <TextView
                    android:id="@+id/go_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/img_next_page"
                    android:layout_marginRight="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/radio_button_selected_color"
                    android:textSize="16dp"
                    android:text="@string/text_next" />
                <ImageView
                    android:id="@+id/img_next_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_start_24"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

        </LinearLayout>
    <!--</com.weigh.safe.helpers.ZoomableRelativeLayout>-->

</com.otaliastudios.zoom.ZoomLayout>