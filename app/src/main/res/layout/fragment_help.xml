<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HelpFragment"
    android:background="#eeeeee">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/main_dimen_40"
        android:background="@color/colorPrimaryDark">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:src="@drawable/back" />

        <TextView
            android:id="@+id/help_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_help_title"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:ellipsize="end"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/help_category"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar">

        <TextView
            android:id="@+id/help_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Instruction Guide"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
        <TextView
            android:id="@+id/help_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Instruction Video"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:layout_below="@id/help_guide"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
        <TextView
            android:id="@+id/help_maintenance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Maintenance"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:layout_below="@id/help_video"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
        <TextView
            android:id="@+id/help_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Frequently Asked Questions"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:layout_below="@id/help_maintenance"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
        <TextView
            android:id="@+id/help_warranty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Warranty"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:layout_below="@id/help_ask"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
        <TextView
            android:id="@+id/help_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textAlignment="center"
            android:ellipsize="end"
            android:text="Contact Us"
            android:textColor="@color/colorPrimaryDark"
            android:padding="10dp"
            android:layout_below="@id/help_warranty"
            android:background="@color/colorWhite"
            android:layout_marginBottom="2sp"
            />
    </RelativeLayout>

</RelativeLayout>