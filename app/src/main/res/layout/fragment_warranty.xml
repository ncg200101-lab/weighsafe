<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HelpFragment"
    android:background="@color/colorWhite">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/colorPrimaryDark">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_marginLeft="10dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@+id/warranty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/warranty_title"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:ellipsize="end"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_bar"
        >
        <RelativeLayout
            android:id="@+id/help_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/header_bar">
            <TextView
                android:id="@+id/text_warranty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"
                android:padding="10dp"
                android:textAlignment="center"
                android:text="@string/text_warranty_title"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/warranty_content"
                android:layout_below="@id/text_warranty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:padding="10dp"
                android:text="@string/text_warranty_content"
                android:textSize="12sp"/>
        </RelativeLayout>
    </ScrollView>


</RelativeLayout>