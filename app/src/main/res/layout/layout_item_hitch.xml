<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_hitch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorWhite"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_hitch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/txt_hitch_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="True Tow Weight\nDistribution Hitch"
            android:layout_alignParentLeft="true"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorBlack"/>

        <Button
            android:id="@+id/btn_activate"
            android:layout_width="70dp"
            android:layout_height="20dp"
            android:text="ACTIVE"
            android:layout_alignParentRight="true"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:textAlignment="center"
            android:textSize="12sp"
            android:textColor="@color/colorWhite"
            android:background="@drawable/round_set_default" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_weight_vr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_max_tongue_lbs"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="12sp"
                android:textColor="@color/colorGrey" />

            <TextView
                android:id="@+id/val_max_tonguelbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,500"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_ball"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="12sp"
                android:textColor="@color/colorGrey" />

            <TextView
                android:id="@+id/val_ball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="n/a"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_shank"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="12sp"
                android:textColor="@color/colorGrey" />

            <TextView
                android:id="@+id/val_shank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2&quot;"
                android:layout_gravity="left"
                android:layout_marginLeft="10dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorBlack"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
