            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:textSize="16sp"
                android:text="@string/tongue_weight_text_2"/>

            <!--
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/trailerWeightError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:hintEnabled="false">
                <EditText
                    android:id="@+id/guide_trailer_weight"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="15sp"
                    android:background="@drawable/round_border_edittext"
                    android:paddingLeft="5dp"
                    android:hint="@string/text_hint_gtw"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/gross_trailer_weight"/>
