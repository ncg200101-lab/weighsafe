<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.GuideStep6Fragment"
    android:background="@color/colorWhite"
    android:paddingTop="@dimen/main_dimen_40"
    android:paddingLeft="@dimen/main_dimen_40"
    android:paddingRight="@dimen/main_dimen_40"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:transformation="none"
    app:transformationGravity="auto"
    app:alignment="top"
    app:overScrollHorizontal="false"
    app:overScrollVertical="false"
    app:overPinchable="false"
    app:horizontalPanEnabled="true"
    app:verticalPanEnabled="true"
    app:zoomEnabled="true"
    app:scrollEnabled="true"
    app:oneFingerScrollEnabled="true"
    app:twoFingersScrollEnabled="true"
    app:minZoom="1"
    app:minZoomType="zoom"
    app:maxZoom="5"
    app:maxZoomType="zoom"
    app:animationDuration="280"
    app:hasClickableChildren="true">

    <!--<com.weigh.safe.helpers.ZoomableRelativeLayout-->
