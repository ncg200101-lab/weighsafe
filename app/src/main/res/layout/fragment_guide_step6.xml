                <EditText
                    android:id="@+id/guide_trailer_name"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:inputType="textCapWords"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
