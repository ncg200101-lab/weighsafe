            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/tongue_weight_text_3"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tongueWeightError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:hintEnabled="false">
                <EditText
                    android:id="@+id/guide_tongue_weight"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="15sp"
                    android:background="@drawable/round_border_edittext"
                    android:paddingLeft="5dp"
                    android:hint="@string/text_hint_axle"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/guide_safe_tongue_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="18sp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"/>

            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="25dp"
                android:adjustViewBounds="true"
                android:src="@drawable/tongue_weight"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/tongue_weight_text_4"/>
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/step6d"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/tongue_weight_text_5"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/axle_inch_Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:hintEnabled="false">
                <EditText
                    android:id="@+id/guide_axle_inch"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="15sp"
                    android:background="@drawable/round_border_edittext"
                    android:paddingLeft="5dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:hint="@string/text_hint_axle"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:adjustViewBounds="true"
                android:padding="15dp"
                android:src="@drawable/step6a"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/tongue_weight_text_6"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/spring_inch_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:hintEnabled="false">
                <EditText
                    android:id="@+id/guide_spring_inch"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="15sp"
                    android:background="@drawable/round_border_edittext"
                    android:paddingLeft="5dp"
                    android:hint="@string/text_hint_axle"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:adjustViewBounds="true"
                android:padding="15dp"
                android:src="@drawable/step6b"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/tongue_weight_text_7"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/trailer_inch_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:passwordToggleEnabled="true"
                app:hintEnabled="false">
                <EditText
                    android:id="@+id/guide_trailer_inch"
                    android:layout_marginTop="@dimen/main_dimen_40"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:textColor="@color/colorBlack"
                    android:textSize="15sp"
                    android:background="@drawable/round_border_edittext"
                    android:paddingLeft="5dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:hint="@string/text_hint_axle"/>
            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:src="@drawable/step6c"/>
            <TextView
                android:id="@+id/close_guide"
                android:visibility="gone"
                android:layout_margin="@dimen/main_dimen_40"
                android:textAlignment="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryDark"
                android:text="@string/close_guide"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/main_dimen_40">
                <ImageView
                    android:id="@+id/img_back_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back_24"/>

                <TextView
                    android:id="@+id/go_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/img_back_page"
                    android:layout_marginLeft="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/colorGrey"
                    android:textSize="16dp"
                    android:text="@string/text_back" />

                <TextView
                    android:id="@+id/go_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/img_next_page"
                    android:layout_marginRight="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/radio_button_selected_color"
                    android:textSize="16dp"
                    android:text="@string/text_next" />
                <ImageView
                    android:id="@+id/img_next_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_start_24"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

        </LinearLayout>

    <!--</com.weigh.safe.helpers.ZoomableRelativeLayout>-->

</ScrollView>