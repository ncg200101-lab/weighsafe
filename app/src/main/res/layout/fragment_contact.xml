<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HelpFragment"
    android:background="@color/colorWhite">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/colorPrimaryDark">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_marginLeft="10dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@+id/contact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contact_title"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:ellipsize="end"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_below="@id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="2"
        android:gravity="center"
        android:paddingHorizontal="50dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:src="@drawable/ws_logo"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contact_content"
            android:textAlignment="center"
            android:textSize="16dp"
            android:layout_marginTop="50dp"/>
        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/contact_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/contact_phone"
            android:textColor="@color/colorPrimaryDark"
            android:textAlignment="center"
            android:padding="8dp"
            />
        <TextView
            android:id="@+id/contact_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/contact_mail"
            android:textColor="@color/colorPrimaryDark"
            android:textAlignment="center"
            android:padding="8dp"
            />
        <TextView
            android:id="@+id/contact_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="@string/contact_url"
            android:textColor="@color/colorPrimaryDark"
            android:textAlignment="center"
            android:padding="8dp"
            />

    </LinearLayout>


</RelativeLayout>