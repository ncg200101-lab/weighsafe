<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activities.NewHitchActivity"
    android:background="@color/colorWhite">

    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingHorizontal="@dimen/main_dimen_40"
        android:background="@color/colorPrimaryDark">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:src="@drawable/back" />

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_new_hitch"
            android:textAlignment="center"
            android:layout_centerVertical="true"
            android:ellipsize="end"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/edit_btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_btn_save"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"
            />
    </RelativeLayout>
    <ScrollView
        android:id="@+id/scrollbar_edit"
        android:layout_below="@id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/ll_weigh_safe_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5">

                    <com.github.angads25.toggle.LabeledSwitch
                        android:id="@+id/toggle_weighsafe"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="16dp"
                        android:textSize="14sp"
                        app:on="true"
                        app:textOn="ON"
                        app:textOff="OFF"
                        app:colorOn="@color/colorPrimaryDark"
                        app:colorBorder="@color/colorPrimaryDark"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="4"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="30dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/lb_weigh_safe_hitch"
                            android:textColor="@color/colorBlack"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_centerVertical="true"
                            android:text="@string/lb_no_weigh_safe_hitch"
                            android:textColor="@color/colorBlack"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/link_how_weigh_safe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:layout_centerVertical="true"
                            android:text="@string/link_how_to_weighsafe"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/edit_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/main_dimen_40">

                    <LinearLayout
                        android:id="@+id/ll_hitch_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/lb_hitch_model"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp" />

                        <Spinner
                            android:id="@+id/spinner_hitch_model"
                            android:theme="@style/ThemeOverlay.AppCompat.Light"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/dropdownListPreferredItemHeight"
                            android:spinnerMode="dropdown"
                            android:dropDownWidth="300dp"
                            android:entries="@array/hitch_model_list"
                            android:dropDownVerticalOffset="?attr/dropdownListPreferredItemHeight"
                            android:popupBackground="@android:color/white"
                            android:popupElevation="3dp"
                            android:stateListAnimator="@drawable/spinner_sla"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/ll_name_hitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_hitch_model"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/hitch_name_label"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/hitch_name_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:singleLine="true"
                            android:textColor="@color/colorBlack"
                            android:textSize="22sp"
                            android:hint="(i.e. Curt, Reese, BW Hitch"
                            android:textColorHint="@color/grey60"
                            android:background="@drawable/bottom_line_edittext"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_name_hitch"
                        android:orientation="vertical"
                        android:paddingBottom="7dp"
                        android:paddingTop="7dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/rl_img_type"
                                android:text="@string/lb_hitch_type"
                                android:textColor="@color/colorBlack"
                                android:textSize="16sp" />

                            <RelativeLayout
                                android:id="@+id/rl_img_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true">

                                <ImageView
                                    android:id="@+id/img_sub_type"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    android:layout_margin="10dp"
                                    android:clickable="true"
                                    android:src="@drawable/info" />
                            </RelativeLayout>
                        </RelativeLayout>

                        <Spinner
                            android:id="@+id/spinner_hitch_type"
                            android:theme="@style/ThemeOverlay.AppCompat.Light"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/dropdownListPreferredItemHeight"
                            android:spinnerMode="dropdown"
                            android:entries="@array/hitch_type_list"
                            android:dropDownWidth="300dp"
                            android:dropDownVerticalOffset="?attr/dropdownListPreferredItemHeight"
                            android:popupBackground="@android:color/white"
                            android:popupElevation="3dp"
                            android:stateListAnimator="@drawable/spinner_sla"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_max_gtwr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_type"
                        android:orientation="vertical"
                        android:paddingBottom="7dp"
                        android:paddingTop="7dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/rl_img_gtwr"
                                android:text="@string/text_max_gtwr"
                                android:textColor="@color/colorBlack"
                                android:textSize="16sp" />

                            <RelativeLayout
                                android:id="@+id/rl_img_gtwr"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true">

                                <ImageView
                                    android:id="@+id/img_sub_gtwr"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    android:layout_margin="10dp"
                                    android:clickable="true"
                                    android:src="@drawable/info" />
                            </RelativeLayout>
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/edit_max_gtwr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:singleLine="true"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/colorBlack"
                            android:textSize="22sp"
                            android:hint="lbs"
                            android:textColorHint="@color/grey60"
                            android:background="@drawable/bottom_line_edittext"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_mtw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_max_gtwr"
                        android:orientation="vertical"
                        android:paddingBottom="7dp"
                        android:paddingTop="7dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_toLeftOf="@+id/rl_img_mtw"
                                android:text="@string/text_max_tongue_weight"
                                android:textColor="@color/colorBlack"
                                android:textSize="16sp" />

                            <RelativeLayout
                                android:id="@+id/rl_img_mtw"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true">

                                <ImageView
                                    android:id="@+id/img_sub_mtw"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    android:layout_margin="10dp"
                                    android:clickable="true"
                                    android:src="@drawable/info" />
                            </RelativeLayout>
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/edit_max_tongue_weight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:singleLine="true"
                            android:inputType="numberDecimal|numberSigned"
                            android:textColor="@color/colorBlack"
                            android:textSize="22sp"
                            android:hint="lbs"
                            android:textColorHint="@color/grey60"
                            android:background="@drawable/bottom_line_edittext"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_ball_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_mtw"
                        android:orientation="vertical"
                        android:paddingBottom="7dp"
                        android:paddingTop="7dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/text_ball_size"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp" />

                        <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                            android:id="@+id/btn_group_ballsize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:elevation="3dp"
                            android:background="@android:color/darker_gray"
                            app:divider="@color/grey60"
                            app:dividerPadding="5dp"
                            app:dividerWidth="2dp"
                            app:draggable="true"
                            app:position="0"
                            app:radius="5dp"
                            app:ripple="true"
                            app:rippleColor="@color/grey60"
                            app:selectedButtonRadius="5dp"
                            app:selectedBackground="@android:color/white">

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_ball_val_3"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_ball_val_2"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_ball_val_1"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>
                        </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_shank_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_ball_size"
                        android:orientation="vertical"
                        android:paddingBottom="7dp"
                        android:paddingTop="7dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/text_shank_size"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp" />

                        <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                            android:id="@+id/btn_group_shanksize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:elevation="3dp"
                            android:background="@android:color/darker_gray"
                            app:divider="@color/grey60"
                            app:dividerPadding="5dp"
                            app:dividerWidth="2dp"
                            app:draggable="true"
                            app:position="0"
                            app:radius="5dp"
                            app:ripple="true"
                            app:rippleColor="@color/grey60"
                            app:selectedButtonRadius="5dp"
                            app:selectedBackground="@android:color/white">

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_shank_val_1"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_shank_val_2"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="5dp"
                                app:selectedTextColor="@color/colorBlack"
                                app:text="@string/btn_shank_val_3"
                                app:textColor="@android:color/black"
                                app:textSize="15sp"/>

                        </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/link_installation_guide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/ll_shank_size"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:layout_centerHorizontal="true"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/link_installation_guide"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/ll_delete_hitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:gravity="end"
                        android:layout_below="@+id/link_installation_guide"
                        android:layout_marginTop="15dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_trash_24" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/text_Delete_hitch"
                            android:textColor="@color/colorGrey"
                            android:textSize="16sp" />
                    </LinearLayout>


                </RelativeLayout>
            </LinearLayout>



        </LinearLayout>

    </ScrollView>

</RelativeLayout>