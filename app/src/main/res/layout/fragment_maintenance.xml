<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.HelpFragment"
    android:background="@color/colorWhite">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/colorPrimaryDark">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_marginLeft="10dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/back" />

        <TextView
            android:id="@+id/maintenance_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_maintenance_title"
            android:layout_centerVertical="true"
            android:textAlignment="center"
            android:ellipsize="end"
            android:textColor="@color/colorWhite"
            android:textSize="18sp"/>
    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_bar"
        >
        <RelativeLayout
            android:id="@+id/help_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <TextView
                android:id="@+id/maintenance_content_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:ellipsize="end"
                android:text="@string/text_maintenance_content_1"
                android:textColor="@color/colorPrimaryDark"
                android:padding="10dp"
                android:layout_marginBottom="2sp"
                />
            <TextView
                android:id="@+id/maintenance_content_2"
                android:layout_below="@+id/maintenance_content_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:padding="10dp"
                android:text="@string/text_maintenance_content_2"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/maintenance_content_3"
                android:layout_below="@+id/maintenance_content_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:padding="10dp"
                android:text="@string/text_maintenance_content_3"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/figure21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:adjustViewBounds="true"
                android:layout_below="@id/maintenance_content_3"
                app:srcCompat="@drawable/figure21"
                />
            <TextView
                android:id="@+id/maintenance_content_4"
                android:layout_below="@+id/figure21"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorBlack"
                android:padding="10dp"
                android:text="@string/text_maintenance_content_4"
                android:textSize="16sp"/>
            <ImageView
                android:id="@+id/figure22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="50dp"
                android:paddingRight="50dp"
                android:adjustViewBounds="true"
                android:layout_below="@id/maintenance_content_4"
                app:srcCompat="@drawable/figure22"
                />

        </RelativeLayout>
    </ScrollView>


</RelativeLayout>