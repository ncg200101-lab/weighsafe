<?xml version="1.0" encoding="utf-8"?>
<com.otaliastudios.zoom.ZoomLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".fragments.GuideStep3Fragment"
    android:background="@color/colorWhite"
    android:paddingTop="@dimen/main_dimen_40"
    android:paddingLeft="@dimen/main_dimen_40"
    android:paddingRight="@dimen/main_dimen_40"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:transformation="none"
    app:transformationGravity="auto"
    app:alignment="top"
    app:overScrollHorizontal="false"
    app:overScrollVertical="false"
    app:overPinchable="false"
    app:horizontalPanEnabled="true"
    app:verticalPanEnabled="true"
    app:zoomEnabled="true"
    app:scrollEnabled="true"
    app:oneFingerScrollEnabled="true"
    app:twoFingersScrollEnabled="true"
    app:minZoom="1"
    app:minZoomType="zoom"
    app:maxZoom="5"
    app:maxZoomType="zoom"
    app:animationDuration="280"
    app:hasClickableChildren="true">

    <!--<com.weigh.safe.helpers.ZoomableRelativeLayout-->
        <!--android:layout_width="match_parent"-->
        <!--android:layout_height="wrap_content">-->
        <LinearLayout
            android:id="@+id/step_linearlayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/colorBlack"
                android:text="@string/head_assemble"/>
            <TextView
                android:layout_marginTop="15sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/step_3_notice"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/main_dimen_40"
                android:text="@string/head_assemble_text_1"
                android:textColor="@color/colorBlack"
                android:textSize="16sp" />
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/step3a"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/head_assemble_text_2"/>
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:adjustViewBounds="true"
                android:src="@drawable/step3b"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/head_assemble_text_3"/>
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:adjustViewBounds="true"
                android:src="@drawable/step3c"/>
            <ImageView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:adjustViewBounds="true"
                android:src="@drawable/step3d"/>
            <TextView
                android:layout_marginTop="@dimen/main_dimen_40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorBlack"
                android:text="@string/head_assemble_text_4"/>

            <info.hoang8f.android.segmented.SegmentedGroup xmlns:segmentedgroup="http://schemas.android.com/apk/res-auto"
                android:id="@+id/gudie_segmented1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="10sp"
                android:layout_marginTop="10sp"
                android:weightSum="2">

                <RadioButton
                    android:id="@+id/guide_btn_rise"
                    style="@style/RadioButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_raise" />

                <RadioButton
                    android:id="@+id/guide_btn_drop"
                    style="@style/RadioButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_drop" />
            </info.hoang8f.android.segmented.SegmentedGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/main_dimen_40"
                android:text="@string/head_assemble_text_5"
                android:textColor="@color/colorBlack"
                android:textSize="16sp" />
            <RelativeLayout
                android:layout_marginTop="10sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/guide_holes_content_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10sp"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"
                    android:text="@string/holes_content_text"
                    />
                <TextView
                    android:layout_toRightOf="@id/guide_holes_content_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="@string/holes_content_unit"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"/>

                <info.hoang8f.android.segmented.SegmentedGroup
                    xmlns:segmentedgroup="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/guide_segmented2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/guide_btn_minus"
                        style="@style/RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:text="@string/btn_minus" />

                    <RadioButton
                        android:id="@+id/guide_btn_plus"
                        style="@style/RadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:text="@string/btn_plus" />
                </info.hoang8f.android.segmented.SegmentedGroup>

            </RelativeLayout>
            <TextView
                android:id="@+id/close_guide"
                android:visibility="gone"
                android:layout_margin="@dimen/main_dimen_40"
                android:textAlignment="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/colorPrimaryDark"
                android:text="@string/close_guide"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/main_dimen_40">
                <ImageView
                    android:id="@+id/img_back_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back_24"/>

                <TextView
                    android:id="@+id/go_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/img_back_page"
                    android:layout_marginLeft="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/colorGrey"
                    android:textSize="16dp"
                    android:text="@string/text_back" />

                <TextView
                    android:id="@+id/go_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/img_next_page"
                    android:layout_marginRight="10dp"
                    android:textAlignment="center"
                    android:textColor="@color/radio_button_selected_color"
                    android:textSize="16dp"
                    android:text="@string/text_next" />
                <ImageView
                    android:id="@+id/img_next_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_start_24"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>



        </LinearLayout>
    <!--</com.weigh.safe.helpers.ZoomableRelativeLayout>-->

</com.otaliastudios.zoom.ZoomLayout>