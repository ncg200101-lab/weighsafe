<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment2_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWhite"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".fragments2.HomeFragment">

    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/colorPrimaryDark">
        <include
            android:id="@+id/setup_header"
            layout="@layout/setup_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:visibility="visible" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/scrollview_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_bar">

        <RelativeLayout
            android:id="@+id/setup_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <LinearLayout
                android:id="@+id/ll_hitchmenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">
                <ImageView
                    android:id="@+id/img_left_satisfy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.15"
                    android:src="@drawable/ic_hand_thumbsup_24"
                    android:layout_gravity="center_vertical"/>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7">
                    <RelativeLayout
                        android:id="@+id/rl_hitchtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorWhite"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">
                        <TextView
                            android:id="@+id/txt_hitchtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:layout_centerInParent="true"
                            android:text="@string/hitch_sample1"
                            android:textAllCaps="true"
                            android:textColor="@color/colorBlack"
                            android:textSize="16sp"
                            android:textAlignment="center"
                            />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_hitchmenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rl_hitchtitle"
                        android:background="@color/colorWhite">

                        <TextView
                            android:id="@+id/txt_helpsetup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/hitch_menu"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </RelativeLayout>

                <ImageView
                    android:id="@+id/img_right_satisfy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.15"
                    android:src="@drawable/ic_hand_thumbsup_24"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/img_vehicle_setup"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_below="@id/ll_hitchmenu"
                android:layout_centerVertical="true"
                android:padding="10dp"
                app:srcCompat="@drawable/trailer_setup_bumper" />

            <LinearLayout
                android:id="@+id/ll_weight_vr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/img_vehicle_setup"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/ll_gvwr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_gvwr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_gvwr"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_gcwr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/val_gcwr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textAlignment="center"
                        android:textColor="@color/colorBlack"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_gcwr"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_gtwr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_gtwr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_gtwr"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
            android:id="@+id/ll_cargoview"
            android:layout_below="@id/ll_weight_vr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2.01">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:paddingLeft="50dp"
                    android:paddingRight="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_vehicle"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_cargo"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />
                    <EditText
                        android:id="@+id/val_cargo_vehicle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:inputType="number"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"
                        android:background="@drawable/dashed_line"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/round_stepper_button"
                        android:weightSum="2.01"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btn_minus_cargo"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:layout_weight="1"
                            android:text="-"
                            android:textSize="18sp"
                            android:background="@android:color/transparent">
                        </Button>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.01"
                            android:layout_gravity="center"
                            android:background="@color/colorGrey">
                        </View>

                        <Button
                            android:id="@+id/btn_plus_cargo"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:layout_weight="1"
                            android:text="+"
                            android:textSize="18sp"
                            android:background="@android:color/transparent">
                        </Button>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/label_vehicle_adj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:text=""
                        android:textColor="@color/colorPrimary"
                        android:background="@android:color/transparent" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.01"
                    android:layout_gravity="center"
                    android:background="@color/colorBrightGrey">
                </View>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:paddingLeft="50dp"
                    android:paddingRight="50dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_trailer"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_cargo"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />
                    <EditText
                        android:id="@+id/val_cargo_trailer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:inputType="number"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"
                        android:background="@drawable/dashed_line"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/round_stepper_button"
                        android:weightSum="2.01"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btn_minus_cargo_trailer"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:layout_weight="1"
                            android:text="-"
                            android:textSize="18sp"
                            android:background="@android:color/transparent">
                        </Button>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="20dp"
                            android:layout_weight="0.01"
                            android:layout_gravity="center"
                            android:background="@color/colorGrey">
                        </View>

                        <Button
                            android:id="@+id/btn_plus_cargo_trailer"
                            android:layout_width="0dp"
                            android:layout_height="35dp"
                            android:layout_weight="1"
                            android:text="+"
                            android:textSize="18sp"
                            android:background="@android:color/transparent">
                        </Button>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/label_trailer_adj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:text=""
                        android:textColor="@color/colorPrimary"
                        android:background="@android:color/transparent" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_weight_estimated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_cargoview"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/ll_est_gvw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_est_gvw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_est_gvw"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_est_gcw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_est_gcw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_est_gcw"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_est_gtw"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/val_est_gtw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_est_gtw"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_tongue_weight"
                android:layout_below="@+id/ll_weight_estimated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@color/colorLightGrey"
                android:orientation="horizontal"
                android:weightSum="2.0">
                <LinearLayout
                    android:id="@+id/ll_actual_tongueweight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lb_tongue_weight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_actual_tongue"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorGrey"/>

                    <EditText
                        android:id="@+id/val_actual_tongueweight"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text=""
                        android:inputType="number"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"
                        android:background="@drawable/dashed_edit_box"
                        android:padding="10dp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_distributed_tongueweight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:padding="15dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_distributed_tongue"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorGrey"/>

                    <Button
                        android:id="@+id/btn_calculate_dis"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="@string/btn_calculate"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorWhite"
                        android:background="@color/colorPrimaryDark"
                        android:padding="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_calculate_results"
                android:layout_below="@+id/ll_tongue_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorLightGrey">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/dashed_red_box">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safe_zone"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryDark"/>

                    <LinearLayout
                        android:id="@+id/ll_calculate_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="11">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/val_min_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorBlack"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/min_lbs"
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textColor="@color/colorGrey" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_left_arrow_back_24_black"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/val_safe_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorBlack"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/target_lbs"
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textColor="@color/colorGrey" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_right_arrow_forward_24_black"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:layout_gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/val_max_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorBlack"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/max_lbs"
                                android:layout_gravity="center"
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textColor="@color/colorGrey" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lb_zone_equalized"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_zone_equalized"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                    <TextView
                        android:id="@+id/edit_measurements"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_measurements"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimaryDark"/>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll_safe_tongue_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_calculate_results"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@color/colorLightGrey">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/val_min_tongueweight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_left_arrow_back_24_black"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/dot_24"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_right_arrow_forward_24_black"/>
                    <TextView
                        android:id="@+id/val_max_tongueweight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:textAlignment="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorBlack"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/lb_safe_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lb_safe_weight_range"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:textColor="@color/colorGrey" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_promo_Box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_safe_tongue_weight"
                android:orientation="vertical"
                android:layout_margin="10dp"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingBottom="20dp"
                android:paddingTop="10dp"
                android:background="@color/colorPrimaryDark">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_promo_1"
                    android:layout_gravity="center"
                    android:textAlignment="center"
                    android:textSize="15sp"
                    android:textColor="@color/colorWhite" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_promo_2"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:textColor="@color/colorWhite" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_drawbar"
                android:layout_below="@id/ll_promo_Box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:weightSum="1">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.45"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:padding="10dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_drawbar_position"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                    <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                        android:id="@+id/btngroup_drawbar_stepper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:elevation="3dp"
                        android:background="@color/colorBrightGrey"
                        app:divider="@color/grey60"
                        app:dividerPadding="5dp"
                        app:dividerWidth="2dp"
                        app:draggable="true"
                        app:position="0"
                        app:radius="5dp"
                        app:ripple="true"
                        app:rippleColor="@color/grey60"
                        app:selectedButtonRadius="5dp"
                        app:selectedBackground="@android:color/white">

                        <com.addisonelliott.segmentedbutton.SegmentedButton
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="5dp"
                            app:selectedTextColor="@android:color/black"
                            app:text="@string/btn_drop"
                            app:textColor="@android:color/black"
                            app:textSize="13sp"/>

                        <com.addisonelliott.segmentedbutton.SegmentedButton
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="5dp"
                            app:selectedTextColor="@android:color/black"
                            app:text="@string/btn_raise"
                            app:textColor="@android:color/black"
                            app:textSize="13sp"/>

                    </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:padding="10dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lb_holes_visible"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/colorGrey" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/val_holes"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8"
                            android:text="0 Holes"
                            android:layout_gravity="center"
                            android:textAlignment="center"
                            android:textSize="15sp"
                            android:textColor="@color/colorBlack" />

                        <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                            android:id="@+id/btn_holes_stepper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:elevation="3dp"
                            android:background="@color/colorBrightGrey"
                            app:divider="@color/grey60"
                            app:dividerPadding="5dp"
                            app:dividerWidth="2dp"
                            app:draggable="true"
                            app:position="0"
                            app:radius="5dp"
                            app:ripple="true"
                            app:rippleColor="@color/grey60"
                            app:selectedButtonRadius="5dp"
                            app:selectedBackground="@color/colorBrightGrey">

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="4dp"
                                app:selectedTextColor="@android:color/black"
                                app:text="-"
                                app:textColor="@android:color/black"
                                app:textSize="16sp"/>

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:padding="4dp"
                                app:selectedTextColor="@android:color/black"
                                app:text="+"
                                app:textColor="@android:color/black"
                                app:textSize="16sp"/>

                        </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

    <RelativeLayout
        android:id="@+id/vehicleListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_navigation"
        android:layout_below="@+id/header_bar"
        android:background="@color/colorPrimary"
        android:paddingLeft="@dimen/main_padding_horizontal"
        android:paddingRight="@dimen/main_padding_horizontal"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/addVehicle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_border"
            android:clickable="true"
            android:onClick="onClickAddVehicle"
            android:paddingBottom="15dp"
            android:paddingTop="15dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_add" />

            <TextView
                android:id="@+id/addText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/imageView"
                android:text="@string/text_dummy_vehicle_title"
                android:textColor="@color/colorWhite"
                android:textSize="15sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/vehicleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/addVehicle"
            android:orientation="vertical"
            android:paddingBottom="15dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vehiclesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                tools:listitem="@layout/row_vehicles" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>