<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/main_padding_horizontal"
    android:paddingRight="@dimen/main_padding_horizontal">

    <TextView
        android:id="@+id/text_checklist_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/btn_reset"
        android:text="@string/text_tow_checklist"
        android:ellipsize="end"
        android:textColor="@color/colorWhite"
        android:textSize="18sp" />
    <Button
        android:id="@+id/btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@android:color/transparent"
        android:text="@string/btn_reset"
        android:textAllCaps="true"
        android:onClick="onClickReset"
        android:textColor="@color/colorWhite"
        android:textSize="18sp" />
</RelativeLayout>