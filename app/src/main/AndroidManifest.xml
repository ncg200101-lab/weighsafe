<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.weigh.safemobile">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="com.weigh.safemobile.app.MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar">
        <activity android:name="com.weigh.safemobile.activities.WelcomeActivity"
            android:screenOrientation="portrait" />
        <activity android:name="com.weigh.safemobile.activities.DisclaimerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.VinLookupActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustNothing" />
        <activity
            android:name="com.weigh.safemobile.activities.MeasurementsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.NewCargoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.NewTrailerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.NewHitchActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.NewVehicleActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.weigh.safemobile.activities.SplashActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.weigh.safemobile.activities.MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan"/>
        <activity
            android:name="com.weigh.safemobile.activities.GuideActivity"
            android:screenOrientation="portrait" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>